# Copy to .env for local development. Values below match docker-compose.yml; never commit real secrets.

# --- API ---
NODE_ENV=development
API_PORT=4000
# PostgreSQL connection string (Prisma).
DATABASE_URL=postgresql://clickauto:clickauto@localhost:5432/clickauto
# Redis: one-time codes, rate limits, queues.
REDIS_URL=redis://localhost:6379
# Origins of the site and the admin allowed for CORS and the Origin check, comma-separated.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
# Public base URL of the API (OAuth callbacks).
PUBLIC_API_URL=http://localhost:4000
# Site URL: redirects after Google sign-in, links in emails.
WEB_URL=http://localhost:3000
# Parent domain for the session cookie in production (e.g. .example.md). Empty locally.
COOKIE_DOMAIN=
# Secret mixed into one-time code hashes. Required and unique in production.
OTP_PEPPER=local-dev-otp-pepper-change-me
# SMTP for emails: Mailpit locally, Spacemail in production.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
MAIL_FROM=ClickAuto <no-reply@localhost>
# Google OAuth client (Google Cloud console). Empty — Google sign-in answers 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# S3-compatible storage for photos (RustFS in docker compose). The bucket is created on start outside production.
S3_ENDPOINT=http://localhost:9000
# S3 host as the browser sees it, for presigned upload URLs. Empty — same as S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=clickauto
S3_ACCESS_KEY=clickauto
S3_SECRET_KEY=clickauto-local
# imgproxy: resizes photos and serves WebP/AVIF.
IMGPROXY_URL=http://localhost:8080
# Hex key and salt for signed imgproxy URLs. Required in production; empty locally — URLs are "insecure".
IMGPROXY_KEY=
IMGPROXY_SALT=

# --- Site (apps/web) ---
# API base URL used by the browser and SSR.
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Admin (apps/admin) ---
VITE_API_URL=http://localhost:4000
