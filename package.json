{
  "name": "clickauto",
  "private": true,
  "packageManager": "pnpm@10.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:generate": "pnpm --filter @clickauto/db generate",
    "db:migrate": "pnpm --filter @clickauto/db migrate:dev",
    "db:seed": "pnpm --filter @clickauto/db seed"
  },
  "devDependencies": {
    "prettier": "3.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
