{
  "name": "worker",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "node --watch -r @swc-node/register src/main.ts",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@clickauto/db": "workspace:*",
    "@clickauto/shared": "workspace:*",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@clickauto/config": "workspace:*",
    "@swc-node/register": "1.12.1",
    "@swc/core": "1.16.21",
    "@types/node": "22.20.5",
    "eslint": "9.39.5",
    "typescript": "5.9.3"
  }
}
